# Copy to /etc/skopos/frontend.env, chown root:skopos, chmod 0640.
# The frontend has no ClickHouse credentials.

SKOPOS_MODE=frontend
SKOPOS_LISTEN_ADDR=127.0.0.1:8080
SKOPOS_QUERY_URLS=http://127.0.0.1:8081
SKOPOS_QUERY_TIMEOUT=30s
SKOPOS_READINESS_TIMEOUT=2s

SKOPOS_LOG_LEVEL=info

# Optional HTTP Basic auth. Use the same credentials in query.env.
# SKOPOS_AUTH_ENABLED=true
# SKOPOS_AUTH_USERNAME=viewer
# SKOPOS_AUTH_PASSWORD=change-me
