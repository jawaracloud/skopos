# Copy to /etc/skopos/gateway.env, chown root:skopos, chmod 0640.
# Do not commit real credentials.

SKOPOS_MODE=all
SKOPOS_LISTEN_ADDR=127.0.0.1:8080

SKOPOS_CLICKHOUSE_URL=http://127.0.0.1:8123
SKOPOS_CLICKHOUSE_DATABASE=otel
SKOPOS_CLICKHOUSE_USER=skopos_gateway
SKOPOS_CLICKHOUSE_PASSWORD=change-me

SKOPOS_LOG_LEVEL=info

# Optional semantic context catalog for /api/v1/context.
# SKOPOS_CONTEXT_FILE=/etc/skopos/context/catalog.json
# SKOPOS_CONTEXT_OBSERVED=true

# Optional HTTP Basic auth. Keep the service behind TLS (reverse proxy) and
# use a strong password. /healthz and /readyz remain unauthenticated.
# SKOPOS_AUTH_ENABLED=true
# SKOPOS_AUTH_USERNAME=viewer
# SKOPOS_AUTH_PASSWORD=change-me
